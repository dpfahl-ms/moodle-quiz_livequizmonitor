{{!
    @template quiz_livequizmonitor/student_table

    Student table for the live quiz monitor.

    Example context (json):
    {
        "filterempty": "No students match the current filters.",
        "showemailcolumn": true,
        "showactionscolumn": true,
        "tableheaders": [
            {
                "label": "Status",
                "sortcolumn": "status",
                "active": true,
                "sorticon": "fa-arrow-up-short-wide",
                "sortlabel": "Ascending",
                "sortclass": "text-primary",
                "sortbylabel": "Sort by Status"
            },
            {
                "label": "Student",
                "sortcolumn": "fullname",
                "active": false,
                "sorticon": "fa-arrow-up-short-wide",
                "sortlabel": "Sort by Student",
                "sortclass": "text-secondary",
                "sortbylabel": "Sort by Student"
            },
            {
                "label": "Email",
                "sortcolumn": "email",
                "active": false,
                "sorticon": "fa-arrow-up-short-wide",
                "sortlabel": "Sort by Email",
                "sortclass": "text-secondary",
                "sortbylabel": "Sort by Email"
            },
            {
                "label": "Progress",
                "sortcolumn": "progress",
                "active": false,
                "sorticon": "fa-arrow-up-short-wide",
                "sortlabel": "Sort by Progress",
                "sortclass": "text-secondary",
                "sortbylabel": "Sort by Progress"
            },
            {
                "label": "Time remaining",
                "sortcolumn": "timeremaining",
                "active": false,
                "sorticon": "fa-arrow-up-short-wide",
                "sortlabel": "Sort by Time remaining",
                "sortclass": "text-secondary",
                "sortbylabel": "Sort by Time remaining"
            }
        ],
        "actionscolumnlabel": "Actions",
        "sortascending": "Ascending",
        "sortdescending": "Descending",
        "students": []
    }
}}
<div class="alert alert-secondary d-none mb-3" data-region="filter-empty" role="status">
    {{filterempty}}
</div>
<div class="table-responsive livequizmonitor-student-list" data-region="student-table">
    <table class="table table-striped generaltable livequizmonitor-table">
    <thead>
        <tr>
            {{#tableheaders}}
            <th data-action="sort-column" data-sort-column="{{sortcolumn}}">
                {{label}}
                {{> quiz_livequizmonitor/sort_icon}}
            </th>
            {{/tableheaders}}

            {{#showactionscolumn}}
            <th>{{actionscolumnlabel}}</th>
            {{/showactionscolumn}}
        </tr>
    </thead>
        <tbody>
            {{#students}}
            {{> quiz_livequizmonitor/student_row }}
            {{/students}}
        </tbody>
    </table>
</div>
